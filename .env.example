# Your useapi.net API token (Settings page on useapi.net). Keep the "user:" prefix.
USEAPI_TOKEN=user:1234-xxxxxxxxxxxxxxxxxxxx

# Random secret that becomes part of the URL: https://your-host/<MCP_ACCESS_KEY>/mcp
# Generate one with:  openssl rand -hex 24
MCP_ACCESS_KEY=

# Optional: pin all requests to one connected Google account
# DEFAULT_EMAIL=yourflowaccount@gmail.com

# Public https address of this deployment — used to build download links for finished episodes
PUBLIC_URL=https://your-app.up.railway.app

PORT=8000
